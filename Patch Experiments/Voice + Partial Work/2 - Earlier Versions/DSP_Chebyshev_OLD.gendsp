                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 540.0, 27.0, 163.0, 22.0 ],
                    "text": "in 2 (signal/float) Shape (0-1)"
                }
            },
            {
                "box": {
                    "code": "dc_blocker(x0, reset)\r\n{\r\n    History x1(0);\r\n    History y1(0);\r\n\r\n    if (reset)\r\n    {\r\n        x1 = 0;\r\n        y1 = 0;\r\n    }\r\n    \r\n    y = x0 - x1 + (0.99 * y1);\n    \n    // Shift memories\n        \r\n    x1 = x0;\n    y1 = y;\r\n    \r\n    return y;\r\n}\r\n\r\nmul_func(idx)\r\n{\r\n    return scale(idx, 2, 8, 0.995, 0.95);\r\n}\r\n\r\ncheby_func(sum, x, m1, m2, add, d, idx)\r\n{\r\n    shape = (2 * x * m1) - m2;\r\n    d = d * d * mul_func(idx);\r\n    \r\n    if (add)\r\n        sum += d * shape;\r\n    \r\n    return sum, shape, m1, d;\r\n}\r\n\r\nParam mode(0, min=0, max=2); // 0 - both, 1 - even, 2 - odd\r\nHistory clear(0);\r\n\r\nx = in1 + 0;\r\nd = sqrt(clip(in2, 0, 1));\r\n\r\nsum = x;\r\nm1 = x;\r\nm2 = 1;\r\n        \r\nodd = mode != 1;\r\neven = mode != 2;\r\n\r\nif (d)\r\n{\r\n    // Harmonic 2\r\n    sum, m1, m2, d = cheby_func(sum, x, m1, m2, even, d, 2);\r\n    \r\n    // Harmonic 3\r\n    sum, m1, m2, d  = cheby_func(sum, x, m1, m2, odd, d, 3);\r\n    \r\n    // Harmonic 4\r\n    sum, m1, m2, d  = cheby_func(sum, x, m1, m2, even, d, 4);\r\n        \r\n    // Harmonic 5\r\n    sum, m1, m2, d  = cheby_func(sum, x, m1, m2, odd, d, 5);\r\n        \r\n    // Harmonic 6\r\n    sum, m1, m2, d  = cheby_func(sum, x, m1, m2, even, d, 6);\r\n    \r\n    // Harmonic 7\r\n    sum, m1, m2, d  = cheby_func(sum, x, m1, m2, odd, d, 7);\r\n        \r\n    // Harmonic 8\r\n    sum, m1, m2, d  = cheby_func(sum, x, m1, m2, even, d, 8);\r\n    \r\n    // DC Block\r\n    \r\n    sum = dc_blocker(sum, clear);\r\n}\r\n\r\nclear = d == 0;\r\n\r\nout1 = sum;",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
