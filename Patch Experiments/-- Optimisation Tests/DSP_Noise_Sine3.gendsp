            {
                "box": {
                    "code": "History x1(0);\r\nHistory x2(0);\r\nHistory y1(0);\r\nHistory y2(0);\r\nHistory clear(0);\r\n\r\n\r\nx  = in3;\r\ncf = in1;\r\nn  = in2;\r\ny  = 0;\r\n\r\nif (n)\r\n{\r\n    s = scale(sqrt(clip(n, 0, 1)), 0, 1, 4, 1.01);\r\n \r\n    // Efficient powers\r\n        \r\n    s2 = s * s;\r\n    s4 = s2 * s2;\r\n    s8 = s4 * s4;\r\n    \r\n    gain = s4 / sqrt(cf) * 100;\r\n    Q = s8;\r\n    \r\n    if (clear)\r\n    {\r\n        x1 = 0;\r\n        x2 = 0;\r\n        y1 = 0;\r\n        y2 = 0;\r\n    }\r\n    \r\n    clear = 0;\r\n    \r\n    omega   = TWOPI / SAMPLERATE;\n    bw      = cf / Q;\n    r1      = exp(-bw * omega);\n    \n    b0  =   1 - r1;\n    b0  =   b0 * gain;\n    b2  = -(r1 - (r1 * r1));\n    b2  =   b2 * gain;\n    a1  = -((r1 + r1) * cos(cf * omega));\r\n    a2  = -(-r1 * r1);\r\n    \r\n    y = b0 * x + b2 * x2 - a1 * y1 - a2 * y2;\r\n    \r\n    x2 = x1;\r\n    x1 = x;\r\n    y2 = y1;\r\n    y1 = y;\r\n}\r\n\r\n\r\nout1 = y;",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-5",
                    "maxclass": "codebox",
                    "numinlets": 3,
                    "numoutlets": 1,
