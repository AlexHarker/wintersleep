                "box": {
                    "code": "tanA2(x)\n{\n\ta\t= ((((x * -0.0896638) + 0.0388452) * x) + 1.00005) * x;\n\tb\t= (((x * -0.430871) + 0.0404318) * x) + 1;\n\treturn\ta / b;\n}\r\n\r\nsvf(x, g, r, a, clear)\n{\n\tHistory\ts1(0), s2(0);\n\r\n    if (clear)\r\n    {\r\n        s1 = 0;\r\n        s2 = 0;\r\n    }\r\n    \n\t// hp\r\n    \n\tyH\t= (x - (r + g) * s1 - s2) * a;\n\n\t// bp\r\n    \n\tgyH\t= g * yH;\n\tyB\t= gyH + s1;\n\ts1\t= gyH + yB;\n\n\t// lp\r\n    \n\tgyB\t= g * yB;\n\tyL\t= gyB + s2;\n\ts2\t= gyB + yL;\n\n\treturn yB;\n}\r\n\r\nsvfResonParam(cutoff, gain, Q)\t\n{\n\tw\t= PI * cutoff / SAMPLERATE;\n\tg \t= tanA2(w);\n\tr \t= 1 / Q;\n\tcB\t= r * gain * 1.995262;        // ^^ +6dB to match MSP\n\th\t= 1 / (1 + (r + g) * g);\n\n\treturn\tg, r, h, cB;\n}\r\n\r\n\r\nHistory clear(0);\r\n\r\n\r\nx  = noise();\r\ncf = in1;\r\nn  = in2;\r\ny  = 0;\r\n\r\nif (n)\r\n{\r\n    s = scale(sqrt(clip(n, 0, 1)), 0, 1, 4, 1.01);\r\n \r\n    // Efficient powers\r\n        \r\n    s2 = s * s;\r\n    s4 = s2 * s2;\r\n    s8 = s4 * s4;\r\n    \r\n    gain = s4 / sqrt(cf) * 100;\r\n    Q = s8;\r\n    \r\n    g, r, h, cB = svfResonParam(cf, gain, Q);\t    \r\n    y = svf(x, g, r, h, clear) * cB;\r\n    \r\n    clear = 0;\r\n}\r\n\r\n\r\nout1 = y;",
