                "box": {
                    "code": "History x1(0);\r\nHistory x2(0);\r\nHistory y1(0);\r\nHistory y2(0);\r\nHistory clear(0);\r\n\r\nx     = noise();\r\ncf    = in1;\r\ngain  = in2;\r\nQ     = in3;\r\n\r\nif (clear)\r\n{\r\n    x1 = 0;\r\n    x2 = 0;\r\n    y1 = 0;\r\n    y2 = 0;\r\n}\r\n\r\nclear = 0;\r\n\r\nomega   = TWOPI / SAMPLERATE;\nbw      = cf / Q;\nr1      = exp(-bw * omega);\nr2      = r1 * r1;\r\n\nb0  =   1 - r1;\nb0  =   b0 * gain;\nb2  = -(r1 - r2);\nb2  =   b2 * gain;\na1  = -((r1 + r1) * cos(cf * omega));\r\na2  =   r2;\r\n\r\ny = b0 * x + b2 * x2 - a1 * y1 - a2 * y2;\r\n\r\nx2 = x1;\r\nx1 = x;\r\ny2 = y1;\r\ny1 = y;\r\n\r\nout1 = y;",
